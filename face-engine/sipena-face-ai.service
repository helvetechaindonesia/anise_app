[Unit]
Description=Sipena Python Face AI Engine (InsightFace 512-D)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/31.97.222.13/face-engine
ExecStart=/www/wwwroot/31.97.222.13/face-engine/venv/bin/uvicorn main:app --host 127.0.0.1 --port 5000 --workers 2
Restart=always
